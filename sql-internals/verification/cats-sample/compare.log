BEGIN;
BEGIN
\echo === index-and-cost ===
=== index-and-cost ===
SELECT relname, relpages, reltuples
FROM pg_class
WHERE oid IN ('public.cats'::regclass, 'public.cats_blood_type_idx'::regclass)
ORDER BY relname;
       relname       | relpages | reltuples 
---------------------+----------+-----------
 cats                |       64 |     10000
 cats_blood_type_idx |       11 |     10000
(2 rows)

SELECT correlation FROM pg_stats
WHERE schemaname = 'public' AND tablename = 'cats' AND attname = 'blood_type';
 correlation 
-------------
           1
(1 row)

SELECT relpages * current_setting('seq_page_cost')::numeric AS page_cost,
       reltuples::numeric * current_setting('cpu_tuple_cost')::numeric AS tuple_cost,
       reltuples::numeric * current_setting('cpu_operator_cost')::numeric AS filter_cost
FROM pg_class WHERE oid = 'public.cats'::regclass;
 page_cost | tuple_cost | filter_cost 
-----------+------------+-------------
        64 |     100.00 |     25.0000
(1 row)

\echo === index-scan ===
=== index-scan ===
SET LOCAL enable_seqscan = off;
SET
SET LOCAL enable_bitmapscan = off;
SET
EXPLAIN SELECT * FROM public.cats WHERE blood_type = 'B';
                                     QUERY PLAN                                     
------------------------------------------------------------------------------------
 Index Scan using cats_blood_type_idx on cats  (cost=0.29..35.78 rows=1000 width=6)
   Index Cond: (blood_type = 'B'::text)
(2 rows)

EXPLAIN SELECT * FROM public.cats WHERE blood_type = 'A';
                                     QUERY PLAN                                      
-------------------------------------------------------------------------------------
 Index Scan using cats_blood_type_idx on cats  (cost=0.29..258.79 rows=9000 width=6)
   Index Cond: (blood_type = 'A'::text)
(2 rows)

\echo === seq-scan ===
=== seq-scan ===
SET LOCAL enable_seqscan = on;
SET
SET LOCAL enable_indexscan = off;
SET
EXPLAIN SELECT * FROM public.cats WHERE blood_type = 'B';
                       QUERY PLAN                        
---------------------------------------------------------
 Seq Scan on cats  (cost=0.00..189.00 rows=1000 width=6)
   Filter: (blood_type = 'B'::text)
(2 rows)

SET LOCAL enable_indexscan = on;
SET
SET LOCAL enable_bitmapscan = on;
SET
\echo === histogram ===
=== histogram ===
ALTER TABLE public.cats ALTER COLUMN id SET STATISTICS 10;
ALTER TABLE
ANALYZE public.cats;
ANALYZE
\x on
Expanded display is on.
