(1 row)


=== REPEATABLE READ ===

--- 接続A ---
TRUNCATE mvcc_books;
INSERT INTO mvcc_books VALUES (42, '星の本');
TRUNCATE TABLE
INSERT 0 1

--- 接続A ---
BEGIN ISOLATION LEVEL REPEATABLE READ;
BEGIN

--- 接続A ---
SELECT id, title, ctid FROM mvcc_books WHERE id = 42;
 id | title  | ctid  
----+--------+-------
 42 | 星の本 | (0,1)
(1 row)


--- 接続B ---
BEGIN;
UPDATE mvcc_books SET title = '新しい星の本' WHERE id = 42;
SELECT id, title, ctid FROM mvcc_books WHERE id = 42;
BEGIN
UPDATE 1
