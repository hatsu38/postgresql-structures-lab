=== ROLLBACKの確認 ===

--- 接続B ---
BEGIN;
UPDATE mvcc_books SET title = '取り消す題名' WHERE id = 42;
BEGIN
UPDATE 1

--- 接続B ---
SELECT id, title, ctid FROM mvcc_books WHERE id = 42;
 id |    title     | ctid  
