
--- 接続A ---
CREATE TABLE mvcc_books (id integer PRIMARY KEY, title text NOT NULL) WITH (autovacuum_enabled = false);
INSERT INTO mvcc_books VALUES (42, '星の本');
CREATE TABLE
INSERT 0 1

=== READ COMMITTED ===

--- 接続A ---
BEGIN ISOLATION LEVEL READ COMMITTED;
BEGIN

--- 接続A ---
SELECT id, title, ctid FROM mvcc_books WHERE id = 42;
 id | title  | ctid  
----+--------+-------
 42 | 星の本 | (0,1)
(1 row)


--- 接続B ---
BEGIN;
UPDATE mvcc_books SET title = '新しい星の本' WHERE id = 42;
SELECT id, title, ctid FROM mvcc_books WHERE id = 42;
BEGIN
UPDATE 1
 id |    title     | ctid  
----+--------------+-------
 42 | 新しい星の本 | (0,2)
(1 row)


--- 接続A ---
SELECT id, title, ctid FROM mvcc_books WHERE id = 42;
 id | title  | ctid  
----+--------+-------
 42 | 星の本 | (0,1)
(1 row)


--- 接続B ---
COMMIT;
COMMIT

--- 接続A ---
SELECT id, title, ctid FROM mvcc_books WHERE id = 42;
 id |    title     | ctid  
----+--------------+-------
 42 | 新しい星の本 | (0,2)
(1 row)


--- 接続A ---
COMMIT;
COMMIT

--- 接続A ---
SELECT id, title, ctid FROM mvcc_books WHERE id = 42;
