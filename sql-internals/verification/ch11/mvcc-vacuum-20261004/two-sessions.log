----+--------------+-------
 42 | 新しい星の本 | (0,2)
(1 row)


--- 接続A ---
SELECT id, title, ctid FROM mvcc_books WHERE id = 42;
 id | title  | ctid  
----+--------+-------
 42 | 星の本 | (0,1)
(1 row)


--- 接続B ---
COMMIT;
COMMIT

--- 接続A ---
