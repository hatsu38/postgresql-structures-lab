CREATE TABLE cats WITH (autovacuum_enabled = false) AS
SELECT n AS id,
       CASE WHEN n <= 9000 THEN 'A' ELSE 'B' END AS blood_type
FROM generate_series(1, 10000) AS n;
SELECT 10000
CREATE INDEX cats_blood_type_idx ON cats(blood_type);
