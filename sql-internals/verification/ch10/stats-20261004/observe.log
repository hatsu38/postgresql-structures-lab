CREATE TABLE stats_demo AS
SELECT n AS id,
       CASE WHEN n <= 9000 THEN 'popular' ELSE 'rare' END AS category
FROM generate_series(1, 10000) AS n;
SELECT 10000
CREATE INDEX stats_demo_category_idx ON stats_demo(category);
CREATE INDEX
