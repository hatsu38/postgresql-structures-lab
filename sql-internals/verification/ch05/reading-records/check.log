-- 計画と結果を同じ設定で確認し、三方式の結果を双方向に比較する。
EXPLAIN (COSTS OFF) SELECT book_id, finished_at FROM reading_records
WHERE finished_at >= '2026-09-20 00:00:00'
  AND finished_at <  '2026-09-21 00:00:00';
                                                                            QUERY PLAN                                                                            
------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Bitmap Heap Scan on reading_records
   Recheck Cond: ((finished_at >= '2026-09-20 00:00:00'::timestamp without time zone) AND (finished_at < '2026-09-21 00:00:00'::timestamp without time zone))
   ->  Bitmap Index Scan on reading_records_finished_at_idx
         Index Cond: ((finished_at >= '2026-09-20 00:00:00'::timestamp without time zone) AND (finished_at < '2026-09-21 00:00:00'::timestamp without time zone))
(4 rows)

CREATE TEMP TABLE bitmap_result ON COMMIT DROP AS
SELECT book_id, finished_at FROM reading_records
WHERE finished_at >= '2026-09-20 00:00:00'
  AND finished_at <  '2026-09-21 00:00:00';
SELECT 71427
SET LOCAL enable_bitmapscan = off;
SET
SET LOCAL enable_seqscan = off;
SET
EXPLAIN (COSTS OFF) SELECT book_id, finished_at FROM reading_records
WHERE finished_at >= '2026-09-20 00:00:00'
  AND finished_at <  '2026-09-21 00:00:00';
                                                                         QUERY PLAN                                                                         
------------------------------------------------------------------------------------------------------------------------------------------------------------
 Index Scan using reading_records_finished_at_idx on reading_records
   Index Cond: ((finished_at >= '2026-09-20 00:00:00'::timestamp without time zone) AND (finished_at < '2026-09-21 00:00:00'::timestamp without time zone))
(2 rows)

CREATE TEMP TABLE index_result ON COMMIT DROP AS
SELECT book_id, finished_at FROM reading_records
